{
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest discover -s tests/architecture -t . -v)",
      "Bash(python3 scripts/check_architecture.py)",
      "Bash(python3 scripts/eval_smoke.py)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "enabledPlugins": {
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/check_typesafe_plugin.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
    "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/check_typesafe_plugin.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
