# Copy to .env and adjust. .env is gitignored; never commit it.
# Docker Compose reads .env automatically. The Python config reads process env
# (e.g. `set -a; source .env; set +a`). Defaults below are for LOCAL DEV ONLY.

ANOMALYOS_ENV=local
ANOMALYOS_SEED=42

CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=anomalyos
CLICKHOUSE_USER=anomalyos
CLICKHOUSE_PASSWORD=change-me-local-only
